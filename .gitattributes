* text=auto eol=lf
*.rs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
