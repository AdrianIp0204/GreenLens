{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GreenLens",
  "version": "0.1.0",
  "identifier": "org.greenlens.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "windows": [{ "title": "GreenLens", "width": 1440, "height": 920, "minWidth": 1100, "minHeight": 740 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "Local building daylight simulation with scientific evidence",
    "copyright": "Copyright 2026 GreenLens contributors",
    "license": "Apache-2.0",
    "resources": {
      "../../../LICENSE": "notices/LICENSE",
      "../../../NOTICE": "notices/NOTICE",
      "../../../dependencies/resolved-inventory.json": "notices/resolved-inventory.json",
      "../../../dependencies/license-supplements.json": "notices/license-supplements.json",
      "../../../dependencies/radiance.json": "notices/radiance.json",
      "../../../docs/dependencies.md": "notices/dependencies.md",
      "../../../docs/windows-runtime.md": "notices/windows-runtime.md",
      "../../../docs/windows-installer.md": "notices/windows-installer.md",
      "../../../third-party/": "notices/third-party/"
    },
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": { "webviewInstallMode": { "type": "skip" }, "nsis": { "installMode": "currentUser", "template": "installer.nsi", "displayLanguageSelector": false } }
  }
}
