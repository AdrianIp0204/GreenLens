{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenlens:energy-report:v0.4",
  "title": "GreenLens EnergyReportData v0.4",
  "description": "Wire shape only. Authoritative Rust validation additionally checks finite arithmetic, reciprocal full-face topology, complete non-leap calendar, schedule roles, exact physical and engine identities, accounting reconciliation and source-bound scientific scope. Deserialization is not evidence integrity or scientific qualification.",
  "$ref": "#/$defs/EnergyReportData",
  "$defs": {
    "BalancedVentilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_flow_m3_s",
        "fraction_schedule",
        "fan_pressure_pa",
        "total_efficiency"
      ],
      "properties": {
        "design_flow_m3_s": {
          "type": "number"
        },
        "fraction_schedule": {
          "type": "string"
        },
        "fan_pressure_pa": {
          "type": "number"
        },
        "total_efficiency": {
          "type": "number"
        }
      }
    },
    "CarbonFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fuel",
        "region",
        "year",
        "kg_per_kwh",
        "unit",
        "source",
        "version",
        "synthetic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "fuel": {
          "$ref": "#/$defs/Fuel"
        },
        "region": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 0
        },
        "kg_per_kwh": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/EmissionUnit"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "CoincidentDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "facility_kw",
        "end_use_contributions_kw",
        "reconciliation_residual_kw"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/EnergyTimestamp"
        },
        "facility_kw": {
          "type": "number"
        },
        "end_use_contributions_kw": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/EnergyEndUse"
          }
        },
        "reconciliation_residual_kw": {
          "type": "number"
        }
      }
    },
    "ComfortSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occupied_hours",
        "cooling_unmet_hours"
      ],
      "properties": {
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "occupied_hours": {
          "type": "number"
        },
        "cooling_unmet_hours": {
          "type": "number"
        },
        "unmet_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CurveForm": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x"
          ],
          "properties": {
            "kind": {
              "const": "quadratic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x"
          ],
          "properties": {
            "kind": {
              "const": "cubic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "biquadratic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "y": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "DayProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 144,
          "maxItems": 144
        }
      }
    },
    "DxCoolingSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gross_rated_capacity_w",
        "gross_rated_cop",
        "rated_shr",
        "rated_airflow_m3_s",
        "rated_indoor_wet_bulb_c",
        "rated_outdoor_dry_bulb_c",
        "capacity_temperature_curve",
        "capacity_flow_curve",
        "eir_temperature_curve",
        "eir_flow_curve",
        "part_load_fraction_curve",
        "availability_schedule",
        "cooling_setpoint_schedule",
        "cooling_deadband_k",
        "supply_fan",
        "balanced_ventilation",
        "sizing_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "gross_rated_capacity_w": {
          "type": "number"
        },
        "gross_rated_cop": {
          "type": "number"
        },
        "rated_shr": {
          "type": "number"
        },
        "rated_airflow_m3_s": {
          "type": "number"
        },
        "rated_indoor_wet_bulb_c": {
          "type": "number"
        },
        "rated_outdoor_dry_bulb_c": {
          "type": "number"
        },
        "capacity_temperature_curve": {
          "type": "string"
        },
        "capacity_flow_curve": {
          "type": "string"
        },
        "eir_temperature_curve": {
          "type": "string"
        },
        "eir_flow_curve": {
          "type": "string"
        },
        "part_load_fraction_curve": {
          "type": "string"
        },
        "availability_schedule": {
          "type": "string"
        },
        "cooling_setpoint_schedule": {
          "type": "string"
        },
        "cooling_deadband_k": {
          "type": "number"
        },
        "supply_fan": {
          "$ref": "#/$defs/SupplyFan"
        },
        "balanced_ventilation": {
          "$ref": "#/$defs/BalancedVentilation"
        },
        "sizing_source": {
          "$ref": "#/$defs/InputSource"
        }
      }
    },
    "EmissionUnit": {
      "enum": [
        "kg_co2",
        "kg_co2e"
      ]
    },
    "EnergyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "evidence_integrity",
        "current_physical_inputs",
        "current_processed_results",
        "current_derived_results",
        "scientific"
      ],
      "properties": {
        "execution": {
          "$ref": "#/$defs/EnergyExecutionStatus"
        },
        "evidence_integrity": {
          "$ref": "#/$defs/EnergyIntegrityScope"
        },
        "current_physical_inputs": {
          "$ref": "#/$defs/EnergyInputRelation"
        },
        "current_processed_results": {
          "$ref": "#/$defs/EnergyInputRelation"
        },
        "current_derived_results": {
          "$ref": "#/$defs/EnergyInputRelation"
        },
        "scientific": {
          "$ref": "#/$defs/EnergyQualification"
        }
      }
    },
    "EnergyCalendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_weekday",
        "holidays",
        "utc_offset_minutes"
      ],
      "properties": {
        "start_weekday": {
          "$ref": "#/$defs/Weekday"
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MonthDay"
          },
          "minItems": 0,
          "maxItems": 365
        },
        "utc_offset_minutes": {
          "type": "integer",
          "minimum": -720,
          "maximum": 840
        }
      }
    },
    "EnergyComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_relation",
        "rows",
        "facility_energy_savings",
        "facility_peak_savings",
        "lighting_service_equivalence",
        "savings_claim_limitations"
      ],
      "properties": {
        "input_relation": {
          "$ref": "#/$defs/EnergyInputComparison"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnergyComparisonRow"
          }
        },
        "facility_energy_savings": {
          "$ref": "#/$defs/Savings"
        },
        "facility_peak_savings": {
          "$ref": "#/$defs/Savings"
        },
        "lighting_service_equivalence": {
          "type": "string"
        },
        "savings_claim_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EnergyComparisonRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_use",
        "baseline_kwh",
        "proposed_kwh",
        "energy_savings",
        "baseline_coincident_kw",
        "proposed_coincident_kw",
        "demand_savings"
      ],
      "properties": {
        "end_use": {
          "$ref": "#/$defs/EnergyEndUse"
        },
        "baseline_kwh": {
          "type": "number"
        },
        "proposed_kwh": {
          "type": "number"
        },
        "energy_savings": {
          "$ref": "#/$defs/Savings"
        },
        "baseline_coincident_kw": {
          "type": "number"
        },
        "proposed_coincident_kw": {
          "type": "number"
        },
        "demand_savings": {
          "$ref": "#/$defs/Savings"
        }
      }
    },
    "EnergyEndUse": {
      "enum": [
        "cooling_system",
        "supply_fans",
        "ventilation_exhaust_fans",
        "interior_lighting",
        "exterior_lighting",
        "plug_equipment"
      ]
    },
    "EnergyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relative_path",
        "sha256",
        "caption",
        "included",
        "rights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "caption": {
          "type": "string"
        },
        "included": {
          "type": "boolean"
        },
        "rights": {
          "type": "string"
        }
      }
    },
    "EnergyExecutionStatus": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "not_executed"
      ]
    },
    "EnergyInputComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparable_geometry_weather_calendar",
        "unchanged_service_inputs",
        "differences",
        "service_warnings"
      ],
      "properties": {
        "comparable_geometry_weather_calendar": {
          "type": "boolean"
        },
        "unchanged_service_inputs": {
          "type": "boolean"
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "service_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EnergyInputRelation": {
      "enum": [
        "current",
        "changed",
        "not_compared"
      ]
    },
    "EnergyIntegrityScope": {
      "enum": [
        "not_checked",
        "metadata_checked",
        "complete_retained_evidence_checked"
      ]
    },
    "EnergyMethodIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "adapter_version",
        "engine_version",
        "engine_package_sha256",
        "engine_executable_sha256",
        "engine_schema_sha256",
        "recipe_sha256",
        "numerical_settings_sha256"
      ],
      "properties": {
        "method_id": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "engine_package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine_executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "engine_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "numerical_settings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EnergyPeriodTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facility_kwh",
        "end_uses_kwh",
        "reconciliation_residual_kwh"
      ],
      "properties": {
        "facility_kwh": {
          "type": "number"
        },
        "end_uses_kwh": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/EnergyEndUse"
          }
        },
        "reconciliation_residual_kwh": {
          "type": "number"
        }
      }
    },
    "EnergyQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "registry_version",
        "reason",
        "tested_scope",
        "applicable_physical_input_sha256",
        "evidence_ids"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/EnergyQualificationStatus"
        },
        "method": {
          "$ref": "#/$defs/EnergyMethodIdentity"
        },
        "registry_version": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "tested_scope": {
          "type": "string"
        },
        "applicable_physical_input_sha256": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EnergyQualificationStatus": {
      "enum": [
        "unassessed",
        "failed",
        "limited_qualified"
      ]
    },
    "EnergyReportAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relative_path",
        "sha256",
        "caption",
        "alt_text",
        "model_input_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "caption": {
          "type": "string"
        },
        "alt_text": {
          "type": "string"
        },
        "model_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "EnergyReportCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "model_id",
        "model",
        "study",
        "weather_summary",
        "model_input_sha256",
        "run_id",
        "record_sha256",
        "physical_input_sha256",
        "processing_sha256",
        "method",
        "assessment",
        "gross_floor_area_m2",
        "conditioned_floor_area_m2",
        "totals",
        "meter_ledger",
        "diagnostics",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "label": {
          "type": "string"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "model": {
          "$ref": "#/$defs/ThermalModel"
        },
        "study": {
          "$ref": "#/$defs/EnergyStudy"
        },
        "weather_summary": {
          "$ref": "#/$defs/EnergyWeatherSummary"
        },
        "model_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "physical_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "processing_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "$ref": "#/$defs/EnergyMethodIdentity"
        },
        "assessment": {
          "$ref": "#/$defs/EnergyAssessment"
        },
        "gross_floor_area_m2": {
          "type": "number"
        },
        "conditioned_floor_area_m2": {
          "type": "number"
        },
        "totals": {
          "$ref": "#/$defs/EnergyTotals"
        },
        "meter_ledger": {
          "$ref": "#/$defs/MeterLedger"
        },
        "diagnostics": {
          "$ref": "#/$defs/EnergyReportDiagnostics"
        },
        "carbon_factor": {
          "anyOf": [
            {
              "$ref": "#/$defs/CarbonFactor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EnergyReportData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "title",
        "revision",
        "scope",
        "baseline",
        "proposed",
        "comparison",
        "assets",
        "evidence",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "greenlens.energy-report.v0.4"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "baseline": {
          "$ref": "#/$defs/EnergyReportCase"
        },
        "proposed": {
          "$ref": "#/$defs/EnergyReportCase"
        },
        "comparison": {
          "$ref": "#/$defs/EnergyComparison"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnergyReportAsset"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnergyEvidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "EnergyReportDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_sha256",
        "messages",
        "convergence_disclosure"
      ],
      "properties": {
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warning_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "severe_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "convergence_disclosure": {
          "type": "string"
        }
      }
    },
    "EnergyStudy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "weather",
        "calendar",
        "zone_timesteps_per_hour"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "greenlens.energy-study.v0.4"
        },
        "weather": {
          "$ref": "#/$defs/EnergyWeatherBinding"
        },
        "calendar": {
          "$ref": "#/$defs/EnergyCalendar"
        },
        "zone_timesteps_per_hour": {
          "type": "integer",
          "minimum": 0,
          "enum": [
            6,
            12
          ]
        }
      }
    },
    "EnergyTimestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_index",
        "month",
        "day",
        "start_minute",
