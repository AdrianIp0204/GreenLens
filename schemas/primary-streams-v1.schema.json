{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenlens:primary-streams:v1",
  "title": "GreenLens retained paired-primary stream receipts",
  "description": "Structural documentation only. Rust additionally validates the complete allowlisted method/profile, sensor and matrix identity, process order, paired receipt equality, recipe hash and matching annual resource measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "sensor_sha256", "sensor_count", "sky_rows", "records"],
  "properties": {
    "schema_version": {"const": "greenlens.annual-primary-streams.v1"},
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["generator_version", "encoding_version", "count"],
      "properties": {
        "generator_version": {"const": "greenlens.hammersley-cosine-primary.v1"},
        "encoding_version": {"const": "greenlens.primary-ascii-e17-lf.v1"},
        "count": {"enum": [16384, 65536, 262144]}
      }
    },
    "sensor_sha256": {"$ref": "#/$defs/sha256"},
    "sensor_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "sky_rows": {"enum": [578, 2306]},
    "records": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["purpose", "process_index", "input", "matrix_sha256", "resources"],
        "properties": {
          "purpose": {"enum": ["full", "direct"]},
          "process_index": {"enum": [4, 6]},
          "input": {
            "type": "object", "additionalProperties": false,
            "required": ["bytes", "records", "sha256"],
            "properties": {
              "bytes": {"type": "integer", "minimum": 2162688, "maximum": 12884901888},
              "records": {"type": "integer", "minimum": 16384, "maximum": 67108864},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "matrix_sha256": {"$ref": "#/$defs/sha256"},
          "resources": {"$ref": "#/$defs/resources"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "sampled_peak_job_plus_runner_working_set_bytes", "peak_child_working_set_bytes", "sampled_peak_runner_plus_child_working_set_bytes", "peak_scratch_bytes", "samples", "zero_progress_writes", "partial_writes", "atomic_job_assignment"],
      "properties": {
        "schema_version": {"const": "greenlens.stream-resources.v2"},
        "sampled_peak_job_plus_runner_working_set_bytes": {"$ref": "#/$defs/memory"},
        "peak_child_working_set_bytes": {"$ref": "#/$defs/memory"},
        "sampled_peak_runner_plus_child_working_set_bytes": {"$ref": "#/$defs/memory"},
        "peak_scratch_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648},
        "samples": {"type": "integer", "minimum": 1},
        "zero_progress_writes": {"type": "integer", "minimum": 0},
        "partial_writes": {"type": "integer", "minimum": 0},
        "atomic_job_assignment": {"const": true}
      }
    },
    "memory": {"type": "integer", "minimum": 1, "maximum": 2147483648}
  }
}
