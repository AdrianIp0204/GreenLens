{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlens.invalid/schemas/scope-history-storage-v0.8.schema.json",
  "title": "GreenLens external immutable scope history index",
  "description": "Disk-only scope_history representation. Rust verifies exact canonical paths, raw bytes, aggregate 32 MiB bound, historical revision algorithms, ordering, parent/source/active bindings and the complete package limits. IPC uses hydrated typed revisions instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries", "active_revision_sha256"],
  "properties": {
    "schema_version": {"const": "greenlens.scope-history.v2"},
    "active_revision_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["revision_sha256", "path", "bytes", "sha256"],
        "properties": {
          "revision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "path": {"type": "string", "pattern": "^scope-history/[a-f0-9]{64}\\.json$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
