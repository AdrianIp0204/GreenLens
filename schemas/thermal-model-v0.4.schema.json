{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenlens:thermal-model:v0.4",
  "title": "GreenLens ThermalModel v0.4",
  "description": "Wire shape only. Authoritative Rust validation additionally checks finite arithmetic, reciprocal full-face topology, complete non-leap calendar, schedule roles, exact physical and engine identities, accounting reconciliation and source-bound scientific scope. Deserialization is not evidence integrity or scientific qualification.",
  "$ref": "#/$defs/ThermalModel",
  "$defs": {
    "BalancedVentilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_flow_m3_s",
        "fraction_schedule",
        "fan_pressure_pa",
        "total_efficiency"
      ],
      "properties": {
        "design_flow_m3_s": {
          "type": "number"
        },
        "fraction_schedule": {
          "type": "string"
        },
        "fan_pressure_pa": {
          "type": "number"
        },
        "total_efficiency": {
          "type": "number"
        }
      }
    },
    "CurveForm": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x"
          ],
          "properties": {
            "kind": {
              "const": "quadratic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x"
          ],
          "properties": {
            "kind": {
              "const": "cubic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "coefficients",
            "x",
            "y"
          ],
          "properties": {
            "kind": {
              "const": "biquadratic"
            },
            "coefficients": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "number"
              }
            },
            "x": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "y": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "DayProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 144,
          "maxItems": 144
        }
      }
    },
    "DxCoolingSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gross_rated_capacity_w",
        "gross_rated_cop",
        "rated_shr",
        "rated_airflow_m3_s",
        "rated_indoor_wet_bulb_c",
        "rated_outdoor_dry_bulb_c",
        "capacity_temperature_curve",
        "capacity_flow_curve",
        "eir_temperature_curve",
        "eir_flow_curve",
        "part_load_fraction_curve",
        "availability_schedule",
        "cooling_setpoint_schedule",
        "cooling_deadband_k",
        "supply_fan",
        "balanced_ventilation",
        "sizing_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "gross_rated_capacity_w": {
          "type": "number"
        },
        "gross_rated_cop": {
          "type": "number"
        },
        "rated_shr": {
          "type": "number"
        },
        "rated_airflow_m3_s": {
          "type": "number"
        },
        "rated_indoor_wet_bulb_c": {
          "type": "number"
        },
        "rated_outdoor_dry_bulb_c": {
          "type": "number"
        },
        "capacity_temperature_curve": {
          "type": "string"
        },
        "capacity_flow_curve": {
          "type": "string"
        },
        "eir_temperature_curve": {
          "type": "string"
        },
        "eir_flow_curve": {
          "type": "string"
        },
        "part_load_fraction_curve": {
          "type": "string"
        },
        "availability_schedule": {
          "type": "string"
        },
        "cooling_setpoint_schedule": {
          "type": "string"
        },
        "cooling_deadband_k": {
          "type": "number"
        },
        "supply_fan": {
          "$ref": "#/$defs/SupplyFan"
        },
        "balanced_ventilation": {
          "$ref": "#/$defs/BalancedVentilation"
        },
        "sizing_source": {
          "$ref": "#/$defs/InputSource"
        }
      }
    },
    "GlazingBasis": {
      "enum": [
        "whole_window",
        "glass_without_frame"
      ]
    },
    "HolidayOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "profile"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/MonthDay"
        },
        "profile": {
          "$ref": "#/$defs/DayProfile"
        }
      }
    },
    "InfiltrationRate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "value"
          ],
          "properties": {
            "basis": {
              "const": "air_changes_per_hour"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "value"
          ],
          "properties": {
            "basis": {
              "const": "flow_m3_per_second"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "value"
          ],
          "properties": {
            "basis": {
              "const": "flow_m3_per_second_per_floor_m2"
            },
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "InputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation",
        "synthetic"
      ],
      "properties": {
        "citation": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "MonthDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "day"
      ],
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        }
      }
    },
    "OpaqueConstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "layers",
        "derived_inside_film_m2k_w",
        "derived_outside_film_m2k_w"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "derived_inside_film_m2k_w": {
          "type": "number"
        },
        "derived_outside_film_m2k_w": {
          "type": "number"
        }
      }
    },
    "PerformanceCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "form",
        "output_limits",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "form": {
          "$ref": "#/$defs/CurveForm"
        },
        "output_limits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      }
    },
    "Schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "weekday",
        "saturday",
        "sunday",
        "holidays"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "kind": {
          "$ref": "#/$defs/ScheduleKind"
        },
        "weekday": {
          "$ref": "#/$defs/DayProfile"
        },
        "saturday": {
          "$ref": "#/$defs/DayProfile"
        },
        "sunday": {
          "$ref": "#/$defs/DayProfile"
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HolidayOverride"
          },
          "minItems": 0,
          "maxItems": 365
        }
      }
    },
    "ScheduleKind": {
      "enum": [
        "fraction",
        "activity_watts_per_person",
        "temperature_celsius"
      ]
    },
    "SupplyFan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pressure_rise_pa",
        "total_efficiency",
        "motor_efficiency",
        "motor_in_air_fraction"
      ],
      "properties": {
        "pressure_rise_pa": {
          "type": "number"
        },
        "total_efficiency": {
          "type": "number"
        },
        "motor_efficiency": {
          "type": "number"
        },
        "motor_in_air_fraction": {
          "type": "number"
        }
      }
    },
    "ThermalBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "outdoors"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "adiabatic"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "insulated_ground"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "zone_id",
            "surface_id"
          ],
          "properties": {
            "kind": {
              "const": "interzone"
            },
            "zone_id": {
              "type": "string"
            },
            "surface_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ThermalBoxShade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin_m",
        "size_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "origin_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "ThermalFace": {
      "enum": [
        "west",
        "east",
        "south",
        "north",
        "floor",
        "roof"
      ]
    },
    "ThermalGlazing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "u_value_w_m2k",
        "shgc",
        "visible_transmittance",
        "basis",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "u_value_w_m2k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shgc": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible_transmittance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "$ref": "#/$defs/GlazingBasis"
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      }
    },
    "ThermalMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "thickness_m",
        "conductivity_w_mk",
        "density_kg_m3",
        "specific_heat_j_kgk",
        "thermal_absorptance",
        "solar_absorptance",
        "visible_absorptance",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "thickness_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conductivity_w_mk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "specific_heat_j_kgk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thermal_absorptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "solar_absorptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visible_absorptance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      }
    },
    "ThermalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "name",
        "site",
        "north_rotation_deg",
        "zones",
        "materials",
        "constructions",
        "glazing",
        "curves",
        "schedules",
        "detached_shading",
        "exterior_lighting_w",
        "exterior_lighting_schedule"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "greenlens.thermal-model.v0.4"
        },
        "name": {
          "type": "string"
        },
        "site": {
          "$ref": "#/$defs/ThermalSite"
        },
        "north_rotation_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalZone"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalMaterial"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "constructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OpaqueConstruction"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "glazing": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalGlazing"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "curves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PerformanceCurve"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "detached_shading": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalBoxShade"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "exterior_lighting_w": {
          "type": "number"
        },
        "exterior_lighting_schedule": {
          "type": "string"
        }
      }
    },
    "ThermalOverhang": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_m",
        "side_extension_m",
        "gap_above_m"
      ],
      "properties": {
        "projection_m": {
          "type": "number"
        },
        "side_extension_m": {
          "type": "number"
        },
        "gap_above_m": {
          "type": "number"
        }
      }
    },
    "ThermalSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude_deg_north",
        "longitude_deg_east",
        "elevation_m"
      ],
      "properties": {
        "latitude_deg_north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg_east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation_m": {
          "type": "number"
        }
      }
    },
    "ThermalSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "face",
        "construction_id",
        "boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "face": {
          "$ref": "#/$defs/ThermalFace"
        },
        "construction_id": {
          "type": "string"
        },
        "boundary": {
          "$ref": "#/$defs/ThermalBoundary"
        }
      }
    },
    "ThermalWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface_id",
        "glazing_id",
        "offset_u_m",
        "offset_v_m",
        "width_m",
        "height_m"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "surface_id": {
          "type": "string"
        },
        "glazing_id": {
          "type": "string"
        },
        "offset_u_m": {
          "type": "number"
        },
        "offset_v_m": {
          "type": "number"
        },
        "width_m": {
          "type": "number"
        },
        "height_m": {
          "type": "number"
        },
        "overhang": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThermalOverhang"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ThermalZone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "storey",
        "origin_m",
        "size_m",
        "surfaces",
        "windows",
        "gains"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string"
        },
        "storey": {
          "type": "integer",
          "minimum": 0,
          "enum": [
            1,
            2
          ]
        },
        "origin_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "size_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalSurface"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThermalWindow"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "gains": {
          "$ref": "#/$defs/ZoneGains"
        },
        "cooling_system": {
          "anyOf": [
            {
              "$ref": "#/$defs/DxCoolingSystem"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ZoneGains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people_per_floor_m2",
        "occupancy_schedule",
        "activity_schedule",
        "people_sensible_fraction",
        "people_radiant_fraction_of_sensible",
        "lighting_w_per_floor_m2",
        "lighting_schedule",
        "lighting_radiant_fraction",
        "lighting_visible_fraction",
        "lighting_return_air_fraction",
        "equipment_w_per_floor_m2",
        "equipment_schedule",
        "equipment_radiant_fraction",
        "equipment_latent_fraction",
        "equipment_lost_fraction",
        "infiltration",
        "infiltration_schedule",
        "source"
      ],
      "properties": {
        "people_per_floor_m2": {
          "type": "number"
        },
        "occupancy_schedule": {
          "type": "string"
        },
        "activity_schedule": {
          "type": "string"
        },
        "people_sensible_fraction": {
          "type": "number"
        },
        "people_radiant_fraction_of_sensible": {
          "type": "number"
        },
        "lighting_w_per_floor_m2": {
          "type": "number"
        },
        "lighting_schedule": {
          "type": "string"
        },
        "lighting_radiant_fraction": {
          "type": "number"
        },
        "lighting_visible_fraction": {
