{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:greenlens:timeseries:v0.3",
  "title": "GreenLens compact climate time series",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "encoding", "ordering", "channels", "units", "sensor_ids", "interval_count", "chunks"],
  "properties": {
    "schema_version": {"const": "greenlens.timeseries.v0.3"},
    "encoding": {"const": "float64_little_endian"},
    "ordering": {"const": "time_sensor_channel"},
    "channels": {"const": ["R", "G", "B", "illuminance"]},
    "units": {"const": ["W/m2_visible_R", "W/m2_visible_G", "W/m2_visible_B", "lx"]},
    "sensor_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "interval_count": {"enum": [1, 8760]},
    "chunks": {"type": "array", "minItems": 1, "maxItems": 53, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "start", "intervals", "bytes", "sha256"],
      "properties": {
        "file": {"type": "string", "pattern": "^data-[0-9]{5}\\.f64$"},
        "start": {"type": "integer", "minimum": 0, "maximum": 8759},
        "intervals": {"type": "integer", "minimum": 1, "maximum": 168},
        "bytes": {"type": "integer", "minimum": 32, "maximum": 1376256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  },
  "$comment": "Rust verifies exact consecutive chunk starts/count/bytes, file hashes, finite nonnegative RGB and lux conversion. The outer immutable run binds weather, time axis, engine and model identity. This is GreenLens evidence encoding, not Radiance binary interchange."
}
